# Production Environment Variables for Backend
# Copy to .env and update with your actual values

# Server Configuration
NODE_ENV=production
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=https://yourdomain.com

# MongoDB Configuration
# Use MongoDB Atlas for production (prefer mongodb+srv on Render/Linux)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/house_rental?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DISABLE_DEV_FALLBACK=true
# Leave unset/false on Render — use platform DNS. Set true only if SRV lookup fails.
MONGODB_USE_PUBLIC_DNS=false

# JWT Configuration (Use strong secrets in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_2024
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production_2024
JWT_REFRESH_EXPIRE=30d

# Email Configuration (Gmail or other SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=YENE BET <your_email@gmail.com>

# M-Pesa Configuration (Safaricom Ethiopia)
MPESA_BASE_URL=https://api.safaricom.et
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/premium/mpesa/callback
MPESA_PHONE_COUNTRY=251
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
PREMIUM_AMOUNT=500
PREMIUM_DAYS=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret

# File Upload (if using cloud storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name
