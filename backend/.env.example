PORT=5000
NODE_ENV=development

# Option 1: Full MongoDB URI (recommended for production)
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/house_rental?retryWrites=true&w=majority&appName=Cluster0

# Option 2: Separate MongoDB credentials (for Atlas)
MONGODB_USER=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_CLUSTER_HOST=cluster0.xxxxx.mongodb.net
MONGODB_DB_NAME=house_rental
MONGODB_APP_NAME=Cluster0

# Disable fallback to local MongoDB in production
MONGODB_DISABLE_DEV_FALLBACK=true

# JWT secrets - generate strong random strings for production
JWT_SECRET=your_super_secret_jwt_key_change_in_production_2024
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production_2024
JWT_REFRESH_EXPIRE=30d

# Admin default credentials (created by seeder)
ADMIN_EMAIL=admin@houserental.com
ADMIN_PASSWORD=admin123

# Email configuration (for verification emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=House Rental <noreply@houserental.com>

# Public base URL of this API (used to build absolute image URLs for uploaded files)
API_BASE_URL=http://localhost:5000

# CORS - must match your frontend URL
FRONTEND_URL=http://localhost:5173